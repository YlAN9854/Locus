# 复制为 .env 并填入真实 Key(.env 不会进 git)。
# 高德 Android SDK Key(包名 com.locus + SHA1)
AMAP_ANDROID_KEY=
# 高德 iOS SDK Key(Bundle ID com.locus.app)
AMAP_IOS_KEY=
# 硅基流动 API Key(https://cloud.siliconflow.cn 获取,用于录音转文字和文本嵌入)
SILICONFLOW_API_KEY=
# 硅基流动语音转文字模型
SILICONFLOW_VOICE_MODEL=TeleAI/TeleSpeechASR
# DeepSeek 官方 API Key(https://platform.deepseek.com/api_keys 获取,用于查询分解)
DEEPSEEK_API_KEY=
# DeepSeek Chat 模型
DEEPSEEK_CHAT_MODEL=deepseek-v4-flash
